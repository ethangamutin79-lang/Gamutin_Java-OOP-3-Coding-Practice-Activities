public class CampusPrintAccount {
  public static void main(String[] args) {
        PrintAccount mia = new PrintAccount("Mia", 10);
        PrintAccount luis = new PrintAccount("Luis", -4);

        System.out.println("Create accounts (Mia 10 credits, Luis -4 credits)");
        System.out.println(mia.getStudentName() + ": " + mia.getCredits());
        System.out.println(luis.getStudentName() + ": " + luis.getCredits());
        System.out.println();

        System.out.println("Mia prints 4 pages: " + mia.printPages(4));
        System.out.println(mia.getStudentName() + ": " + mia.getCredits());
        System.out.println();

        System.out.println("Mia tries to print 7 pages: " + mia.printPages(7));
        System.out.println(mia.getStudentName() + ": " + mia.getCredits());
        System.out.println();

        System.out.println("Mia tries to add -3 credits: " + mia.addCredits(-3));
        System.out.println(mia.getStudentName() + ": " + mia.getCredits());
        System.out.println();

        System.out.println("Mia adds 4 credits: " + mia.addCredits(4));
        System.out.println(mia.getStudentName() + ": " + mia.getCredits());
        System.out.println(luis.getStudentName() + ": " + luis.getCredits());
    }
}

class PrintAccount {
    private final String studentName;
    private int credits;

    public PrintAccount(String studentName, int credits) {
        this.studentName = studentName;

        if (credits < 0) {
            this.credits = 0;
        } else {
            this.credits = credits;
        }
    }

    public boolean addCredits(int amount) {
        if (amount <= 0) {
            return false;
        }

        this.credits += amount;
        return true;
    }

    public boolean printPages(int pages) {
        if (pages <= 0 || pages > this.credits) {
            return false;
        }

        this.credits -= pages;
        return true;
    }

    public int getCredits() {
        return this.credits;
    }

    public String getStudentName() {
        return this.studentName;
    }
}
